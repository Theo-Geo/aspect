# Global parameters
set Dimension                                  = 2
set Start time                                 = 0
set End time                                   = 200
set Use years instead of seconds               = true 
set Nonlinear solver scheme                    = iterated Advection and Stokes
set CFL number                                 = 0.5
set Maximum time step                          = 2.5
set Output directory                           = $ASPECT_SOURCE_DIR/../output/weerdesteijn-test/out-weerdesteijn-2023-2D-no-jump
set Pressure normalization                     = no
set Use operator splitting                     = true

# Solver parameters
subsection Solver parameters

  subsection Stokes solver parameters
    set Linear solver tolerance             = 1e-7
    set Number of cheap Stokes solver steps = 2000
    set GMRES solver restart length = 50
  end

  subsection Operator splitting parameters
    set Reaction solver type                   = fixed step
    set Reaction time step                     = 5000 # larger than maximum Stokes time step
    set Reaction time steps per advection step = 1
  end
end

# Model Geometry 
subsection Geometry model
  set Model name = box

  subsection Box
    set X repetitions = 15
    set Y repetitions = 30
    set X extent      = 1500e3
    set Y extent      = 2891e3
  end
end

# Mesh refinement specifications
subsection Mesh refinement
  set Initial adaptive refinement        = 4
  set Initial global refinement          = 1
  set Time steps between mesh refinement = 1
  set Strategy                           = minimum refinement function
  subsection Minimum refinement function
    set Coordinate system   = cartesian
	set Variable names      = x,y
	set Function expression = y>=2791.e3 ? 4 : 1
  end
end

# Element types
subsection Discretization
  set Composition polynomial degree     = 2
  set Stokes velocity polynomial degree = 2
  set Temperature polynomial degree = 1
  set Use locally conservative discretization = false
  set Use discontinuous temperature discretization = false
  set Use discontinuous composition discretization = true

  subsection Stabilization parameters
    set Use limiter for discontinuous composition solution = false, false, false, false, false, false, true, true, true, true 
    set Global composition maximum =  1.e11,  1.e11,  1.e11,  1.e11,  1.e11,  1.e11, 1.0, 1.0, 1.0, 1.0
    set Global composition minimum = -1.e11, -1.e11, -1.e11, -1.e11, -1.e11, -1.e11, 0.0, 0.0, 0.0, 0.0
  end
end

# Formulation classification
subsection Formulation
  set Enable elasticity = true
end

subsection Mesh deformation
  set Mesh deformation boundary indicators = top: free surface
  set Additional tangential mesh velocity boundary indicators = left, right
  subsection Free surface
    set Surface velocity projection = normal
  end
end

# Velocity boundary conditions
subsection Boundary velocity model
  set Tangential velocity boundary indicators = bottom, left, right
end

# boundary traction
subsection Boundary traction model
  set Prescribed traction boundary indicators = top y: function

  subsection Function
    set Variable names = x,y,t
    set Function constants  = r0=100.e3, H0=1.e2, t1=1.e2, rhoi=931, g=9.815
    # r0 is load radius, H0 is load height, rhoi is density of ice/load, g is surface gravity
    # t1 is end of linear load increase and start of constant load
    set Function expression = 0; if(x<r0, if(t<t1, -g*H0*rhoi*t/t1, -g*H0*rhoi), 0)
  end
end

# Number and name of compositional fields
subsection Compositional fields
  set Number of fields = 10
  set Names of fields  = ve_stress_xx, ve_stress_yy, ve_stress_xy, \
                         ve_stress_xx_old, ve_stress_yy_old,ve_stress_xy_old, \
                         LM, TZ, UM, Lith
  set Types of fields  = stress, stress, stress, stress, stress, stress, chemical composition, chemical composition, chemical composition, chemical composition
end

# Spatial domain of different compositional fields
subsection Initial composition model
  set Model name = function
  subsection Function
    set Variable names      = x,y
    set Function constants  = yLith=10e3, yTZ=50e3
    # set Function expression = 0; 0; 0; 0; 0; 0; if(y<=2221e3,1,0); if(y<=2471e3 && y>2221e3,1,0); if(y<=2821e3 && y>2471e3,1,0); if(y>2821e3,1,0);
    set Function expression = 0; 0; 0; 0; 0; 0; \
    0.5*(1-tanh((y-2221e3)/yTZ)); \
    0.5*(1+tanh((y-2221e3)/yTZ))-0.5*(1+tanh((y-2471e3)/yTZ)); \
    0.5*(1+tanh((y-2471e3)/yTZ))-0.5*(1+tanh((y-2821e3)/yLith)); \
    0.5*(1+tanh((y-2821e3)/yLith));
  end
end

# Composition boundary conditions
subsection Boundary composition model
  set Allow fixed composition on outflow boundaries = true
  set List of model names = initial composition
end


# Temperature boundary conditions
subsection Boundary temperature model
  set Fixed temperature boundary indicators = bottom, top, left, right
  set List of model names = initial temperature
end


# The temperature plays no role in this model
subsection Initial temperature model
  set Model name = function
  subsection Function
    set Function expression = 293
  end
end

# Material model
subsection Material model

  set Model name = viscoelastic

  subsection Viscoelastic
    set Densities                   = 4450 # 4978, 4978, 3871, 3438, 3037
    set Viscosities                 = 2.e21, 2.e21, 1.e21, 1.e21, 1.e40   
    set Elastic shear moduli        = 2.28340e11, 2.28340e11, 1.05490e11, 0.70363e11, 0.50605e11
    set Use fixed elastic time step = false
    set Fixed elastic time step     = 2.5
    set Viscosity averaging scheme  = maximum composition  
  end
end

# Gravity model
subsection Gravity model
  set Model name  = vertical
  subsection Vertical
    set Magnitude = 9.815
  end
end


# Postprocessing
subsection Postprocess
  set List of postprocessors = visualization, basic statistics, composition statistics, topography, velocity statistics
  
  subsection Visualization
    set List of output variables = material properties, nonadiabatic pressure, strain rate
    subsection Material properties
      set List of material properties = density, viscosity
    end

    set Time between graphical output = 2
    set Interpolate output = false
	  set Number of grouped files = 1
  end

  subsection Topography
     set Output to file = true
     set Time between text output = 5
  end
end
