set Dimension                              = 2
set End time                               = 1.5e8
set Use years instead of seconds           = true
set Output directory                       = $ASPECT_SOURCE_DIR/../output/plume_plate_shear/output-heyn-2022

set Maximum first time step                = 1e6
set Maximum time step                      = 1e7
#set Maximum relative increase in time step = 
set Nonlinear solver scheme                = iterated Advection and Stokes
set Nonlinear solver tolerance             = 1e-5
#set CFL number                             = 0.5
#set Use operator splitting = true

subsection Solver parameters
  subsection Stokes solver parameters
    #set Stokes solver type = block GMG
    set Number of cheap Stokes solver steps = 4000
    #set GMRES solver restart length = 150
    set Linear solver tolerance = 1e-8
  end
end

subsection Discretization
  set Stokes velocity polynomial degree = 3
  set Temperature polynomial degree = 3
end


subsection Geometry model
  set Model name = box

  subsection Box
    set X extent = 5500.e3
    set Y extent = 800.e3
    #set X periodic = true
    set X repetitions = 55
    set Y repetitions = 8
  end
end

# subsection Mesh refinement
#   #set Additional refinement times        = 3.5e7
#   set Initial adaptive refinement        = 0
#   set Initial global refinement          = 5 # 5 corresponds to 3x3km
#   set Minimum refinement level           = 2 # 2 corresponds to 25x25km
#   set Coarsening fraction                = 0.2
#   set Refinement fraction                = 0.65
#   set Strategy                           = viscosity, temperature, velocity, boundary
#   set Time steps between mesh refinement = 1 # 0 # no mesh refinement 

#   subsection Boundary
#     set Boundary refinement indicators = top
#   end
# end

subsection Mesh refinement
  #set Additional refinement times        = 3.5e7
  set Initial adaptive refinement        = 1
  set Initial global refinement          = 4 # 5 corresponds to 3x3km
  set Minimum refinement level           = 2 # 2 corresponds to 25x25km
  set Coarsening fraction                = 0.01
  set Refinement fraction                = 0.6
  set Strategy                           = viscosity, temperature, velocity, boundary
  set Time steps between mesh refinement = 5 # 0 # no mesh refinement 

  subsection Boundary
    set Boundary refinement indicators = top
  end

end


# # # Boundary Conditions and Drivers # # #

subsection Gravity model
  set Model name = vertical
  subsection Vertical
    set Magnitude = 9.81
  end
end

subsection Boundary velocity model
  #set Tangential velocity boundary indicators = left, right, bottom
  #set Zero velocity boundary indicators = top
  set Tangential velocity boundary indicators = bottom
  set Prescribed velocity boundary indicators = top:function, right x: function, left x: function
  subsection Function
    set Variable names = x, z, t
    # (m/yr)
    # (m) depth of lithosphere-asthenosphere boundary
    # (m) box depth
    # (m) asthenosphere thickness
    set Function constants =  v = -0.015, DLT = 150.e3, \
                              Dbox = 800.e3, DAS = 150.e3  
    set Function expression = t>0 ? (z>= Dbox-DLT-DAS \
                                      ? (z>=Dbox-DLT ? v : v*(z - (Dbox-DAS-DLT))/DAS ) \
                                      : 0) \
                                  : 0 ; 0; 
  end
end

subsection Boundary temperature model
  set Fixed temperature boundary indicators = bottom, top
  set List of model names = function

  subsection Function
    set Variable names      = x, z, t
    set Function constants = x0=4000.e3, sigma=300.e3, zd=200.e3, \
                             Dbox=800.e3, DLAB=150e3, plume_end=2e8, \
                             dTP=250, TLAB=1500, TLT=273, TLM=1550 # 1623 # K/m
    set Function expression = z>= Dbox - DLAB \
                              ? TLAB - (TLAB-TLT)*(z-Dbox+DLAB)/DLAB \
                              : (t <= plume_end \
                                ? TLM + dTP*exp(-z/zd)*exp( -0.5*( (x-x0)/sigma)^2) \
                                : TLM )
  end
end

subsection Initial temperature model
  set Model name = function

  subsection Function
    set Variable names      = x,z
    set Function constants = x0=4000.e3, sigma=300.e3, zd=200.e3,\
                             Dbox=800.e3, DLAB=150.e3, Dinit=50e3, \
                             dTP=250, TLAB=1500, TLT=273, TLM=1550 # 1623 # K/m
    # linear temperature gradient above and below LAB
    set Function expression = z>= Dbox - DLAB \
                              ? TLAB - (TLAB-TLT)*(z-Dbox+DLAB)/DLAB \
                              : ( z<=Dinit \
                               ? dTP*exp(-z/zd)*exp( -0.5*( (x-x0)/sigma)^2) + TLAB + (TLM-TLAB)/(Dbox-DLAB)*(Dbox-DLAB-z) \
                              : TLAB + (TLM-TLAB)/(Dbox-DLAB)*(Dbox-DLAB-z) )
  end 
end

# # # Composition and material model # # # 

subsection Formulation
  set Formulation =  Boussinesq approximation 
end

subsection Material model 
  set Model name = depth dependent

  subsection Depth dependent model
    set Base model = visco plastic
    set Depth dependence method = List
    set Depth list = 300e3, 805e3
    set Viscosity list = 5e22, 1e24
    set Reference viscosity = 1e22
  end

  #set Model name =  diffusion dislocation
  
  subsection Visco Plastic
    set Reference temperature                       = 273

    set Maximum viscosity                           = 7e25
    set Minimum viscosity                           = 5e17
    #set Minimum viscosity                           = 1e19
    #set Maximum viscosity                           = 1e29
    set Thermal diffusivities                       = 0.8e-6
    set Heat capacities                             = 1250
    #set Thermal diffusivity                         = 0.8e-6
    #set Heat capacity                               = 1250
    set Densities                                   = 3300
    set Thermal expansivities                       = 3.5e-5
    set Viscosity averaging scheme                  = harmonic

    set Viscous flow law                            = composite
    # diffusion creep 
    set Prefactors for diffusion creep              = 8e-12
    set Stress exponents for diffusion creep        = 1
    set Activation energies for diffusion creep     = 250e3
    set Activation volumes for diffusion creep      = 0 # 6e-6
    
    set Grain size = 1e-3
    set Grain size exponents for diffusion creep    = 0
    
    # dislocation creep 
    set Prefactors for dislocation creep = 8e-12 # 1.1e-16
    set Stress exponents for dislocation creep = 1 # 3.5
    set Activation energies for dislocation creep = 250e3 # 5.3e5
    set Activation volumes for dislocation creep = 0 # 1.4e-5

    # Plasticity parameters - irrelevant
    # set to very high value so that it is not used
    #set Cohesions = 1e20
  end 
end


subsection Postprocess
  set List of postprocessors = visualization, velocity statistics, temperature statistics

  subsection Visualization
    set Time between graphical output = 1.e7
    set List of output variables = material properties #, named additional outputs
  end

end

include $ASPECT_SOURCE_DIR/local_prm_files/plume_plate_shear/track_cpo.prm
