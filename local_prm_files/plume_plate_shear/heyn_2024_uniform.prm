set Dimension                              = 2

set Use years in output instead of seconds = true
set End time                               = 2e8
set Output directory                       = $ASPECT_SOURCE_DIR/../output/plume_plate_shear/output-heyn-2024-uniform
set Adiabatic surface temperature          = 1000

# Then there are variables that describe how the pressure should
# be normalized. Here, we choose a zero average pressure
# at the surface of the domain (for the current geometry, the
# surface is defined as the top boundary).
set Pressure normalization                 = surface
set Surface pressure                       = 0

####### NEW FOR MELT TRANSPORT ###############
# For models with melt migration, there is a nonlinear coupling between
# the Stokes system, the temperature, and the advection equation for the 
# porosity (several material properties, such as the viscosities and the
# permeability depend nonlinearly on the porosity; and changes in temperature
# determine how much material is melting or freezing). 
# Because of that, we use a nonlinear solver scheme ('iterated Advection and Stokes')
# that iterates between all of these equations, and we have to set its 
# solver tolerance and the maximum number of iterations separately from 
# the linear solver parameters. 
set Nonlinear solver scheme                = iterated Advection and Stokes
set Max nonlinear iterations               = 40
set Nonlinear solver tolerance             = 1e-5

# In addition, melting and freezing normally happens on a much faster
# time scale than the flow of melt, so we want to decouple the advection
# of melt (and temperature) and the melting process itself. To do that, 
# we use the operator splitting scheme, and define that for every 
# advection time step, we want to do at least 10 reaction time steps. 
# If these time steps would be larger than 10,000 years, we will do 
# more reaction time steps (so that reaction time step size never exceeds 
# 10,000 years). Here, we also specify the Stokes linear solver tolerance
# and maximum number of cheap Stokes solver steps to improve the nonlinear
# convergence behavior.
#set Use operator splitting                     = true
subsection Solver parameters
  # subsection Operator splitting parameters
  #   set Reaction time step                     = 1e3
  #   set Reaction time steps per advection step = 20
  # end
  subsection Stokes solver parameters
    set Linear solver tolerance = 1e-8
    set Number of cheap Stokes solver steps = 4000
  end
end

# subsection Melt settings
# # In addition, we now also specify in the model settings that we want to
# # run a model with melt transport. 
#   set Include melt transport                  = true
#   set Heat advection by melt                  = true
# end

# In models with melt transport, we always need a compositional field with
# the name 'porosity'. Only the field with that name will be advected with
# the melt velocity, all other compositional fields will continue to work
# as before. Material models will typically query for the field with the 
# name porosity to compute all melt material properties. 
# In addition, the 'melt global' material model also requires a field with the
# name 'peridotite'. This field is used to track how much material has been 
# molten at each point of the model, so it tracks the information how the
# composition of the rock changes due to partial melting events (sometimes
# also called depletion). This is important, because usually less melt is
# generated for a given temperature and pressure if the rock has undergone
# melting before. Typically, material properties like the density are also
# different for more or less depleted material.   
# subsection Compositional fields
#   set Number of fields = 2
#   set Names of fields = porosity, peridotite
# end

subsection Discretization
# We also choose relatively large values for the stabilization parameters:
# The model resolution is very coarse (in order for this model to run in a 
# short time), so we want to make sure that no temperature over- and 
# undershoots will develop. In a model with melting this would be 
# particularly problematic, as large amounts of melt could be generated
# by temperature spikes. 
# However, note that in an application model with a higher resolution, 
# we would choose much smaller values for the stabilization parameters. 
  # subsection Stabilization parameters
  #   set beta  = 0.5
  #   set cR    = 1
  # end
  #set Composition polynomial degree = 3
  set Temperature polynomial degree = 3
  set Stokes velocity polynomial degree = 3
end

############## END OF NEW PARTS #########################

# Geometry
subsection Geometry model
  set Model name = box

  subsection Box
    set X extent = 55e5
    set Y extent = 8e5
    set X repetitions = 55
    set Y repetitions = 8
  end
end
## NOTE that X=0,Y=0 is the BOTTOM LEFT corner

# Initial temperature condition
subsection Initial temperature model
  set Model name = function

  subsection Function
    set Variable names      = x,z
    # the constants are: d=lithopshere thickness [m], Tl=temperature at LAB [K], Tb=temperature at domain bottom [K], Ts=surface temperature [K], dt=domain thickness [m], w=width [m], Tm=excess T [K], s=shift [m], Ttbl= temperature at top pf lower TBL [K]
    set Function constants  = d=150e3, Tl=1500, Tb=1550, Ts=273, dt=8e5, w=2e5, Tm=250, s=15e5, Ttbl=1535
    set Function expression = if(z>dt-d, Tl-(z-dt+d)*(Tl-Ts)/d, if(z<140e3, (Tb-z*(Tb-Ttbl)/(140e3))+exp(-z/2e5)*(Tm*exp((-(x-s)^2)/(2*w^2))), Ttbl-(z-140e3)*(Ttbl-Tl)/(dt-d-140e3)))
  end
end


# Temperature boundary conditions
subsection Boundary temperature model
  set Fixed temperature boundary indicators = bottom, top
  set List of model names     = box, function
  set List of model operators = add

  subsection Box
    set Bottom temperature = 1550
    set Top temperature    = 273
  end

  subsection Function
    set Variable names      = x,z,t
    # the parameters are: w=width [m], Tm=excess T [K], s=shift [m], Ts=surface T [K], Tb= bottom T [K], dt=domain thickness [m]
    set Function constants  = w=3e5, Tm=250, s=15e5, Ts=273, Tb=1550, dt=8e5
    set Function expression = if(t<2e8, ((dt-z)/dt)*(Tm*exp((-(x-s)^2)/(2*w^2))), 0)
    set Maximal temperature = 1900
    set Minimal temperature = 273
  end

end


# Velocity boundary conditions
subsection Boundary velocity model
  set Tangential velocity boundary indicators = bottom
  set Prescribed velocity boundary indicators = left x: function, right x: function, top: function
  
  subsection Function
    set Variable names      = x,z,t
    # parameters are: vel=plate velocity [m/year], dl=thickness lithosphere [m], dt=domain thickness [m], da=asthenosphere thickness
    set Function constants  = vel=0.015, dl=150e3, dt=800e3, da=150e3
    set Function expression = if(z>=(dt-dl-30e3) && t>0, vel, if(z<(dt-dl-30e3) && z>(dt-dl-da) && t>0, vel*(z-dt+dl+da)/(da-30e3), 0)); 0
  end
end


# Gravity model
subsection Gravity model
  set Model name = vertical

  subsection Vertical
    set Magnitude = 9.81 
  end
end


# Material model, e.g. visocsity law
subsection Material model
  set Model name =  depth dependent

  set Model name = depth dependent

  subsection Depth dependent model
    set Base model = diffusion dislocation
    set Depth dependence method = List
    set Depth list = 300e3, 805e3
    set Viscosity list = 5e22, 1e24
    set Reference viscosity = 1e22
  end

  #set Model name =  diffusion dislocation
  
  subsection Diffusion dislocation
    set Reference temperature                       = 273
    set Minimum viscosity                           = 1e19
    set Maximum viscosity                           = 1e29
    #set Thermal diffusivity                         = 0.8e-6
    #set Heat capacity                               = 1250
    set Densities                                   = 3300
    set Thermal expansivities                       = 3.5e-5
    set Viscosity averaging scheme                  = harmonic

    # diffusion creep 
    set Prefactors for diffusion creep              = 8e-12
    set Stress exponents for diffusion creep        = 1
    set Activation energies for diffusion creep     = 250e3
    set Activation volumes for diffusion creep      = 0 # 6e-6
    
    set Grain size exponents for diffusion creep    = 0
    
    # dislocation creep 
    set Prefactors for dislocation creep = 8e-12 # 1.1e-16
    set Stress exponents for dislocation creep = 1 # 3.5
    set Activation energies for dislocation creep = 250e3 # 5.3e5
    set Activation volumes for dislocation creep = 0 # 1.4e-5

    # Plasticity parameters - irrelevant
    # set to very high value so that it is not used
    #set Cohesions = 1e20
  end 
end

# Heating model
# subsection Heating model
#   set List of model names = constant heating

#   # pay attention when converting heating values from W/m^3 to W/kg (as required here)
#   # use the reference density of the material model to convert it by division
#   subsection Constant heating
#     set Radiogenic heating rate = 7.58e-12
#   end
# end


# Compressible or incompressible
subsection Formulation
  set Formulation = Boussinesq approximation
end


# Mesh setup
subsection Mesh refinement
  set Initial global refinement                = 2
  set Initial adaptive refinement              = 3
  set Minimum refinement level                 = 2
  set Time steps between mesh refinement       = 1
  set Refinement fraction                      = 0.6
  set Coarsening fraction                      = 0.2
  set Strategy                                 = temperature, velocity, viscosity, boundary
  
  subsection Boundary
    set Boundary refinement indicators = top
  end

end


## set that ASPET gives a checkpoint file for the last step
subsection Termination criteria
  set Checkpoint on termination        = true
end


# Postprocessing
subsection Postprocess
  set List of postprocessors = visualization, velocity statistics, temperature statistics

  subsection Visualization
    set Time between graphical output = 1.e7
    set List of output variables = material properties #, named additional outputs
  end
end
