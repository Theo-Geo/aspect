# We add the necessary plugins through a shared library
set Additional shared libraries            = ./libtosi-aniso.so
set Dimension                              = 2

set Use years instead of seconds           = false
set End time                               = 0.2
set Nonlinear solver scheme                = iterated Advection and Stokes
set Max nonlinear iterations               = 200
set Nonlinear solver tolerance             = 1e-7

# We choose a zero average pressure
# at the surface of the domain (for the current geometry, the
# surface is defined as the top boundary).
set Pressure normalization                 = surface
set Surface pressure                       = 0

subsection Solver parameters
  subsection Stokes solver parameters
    set Stokes solver type = block AMG
    set Number of cheap Stokes solver steps    = 200
    set Linear solver tolerance                = 1e-7
  end
  # subsection Diffusion solver parameters
  #   set Diffusion length scale = 4e-2
  # end
end

# Our model domain is the unit square.
subsection Geometry model
  set Model name = box

   subsection Box
    set X extent = 1
    #set Y extent = 0.0625 #0.03125 #  #  #  
    set Y extent = 1
    set X repetitions = 1 # 32  
    #set Y repetitions = 1
    set Y repetitions = 1 # 32 #  
  end
end

subsection Mesh refinement
  set Initial global refinement           = 4
  #set Additional refinement times         = 0.001
  set Initial adaptive refinement         = 0
  set Time steps between mesh refinement  = 0 #5
  #set Coarsening fraction = 0.01
  #set Refinement fraction = 0.6
  #set Minimum refinement level = 4
  #set Strategy = composition gradient, boundary, temperature
end 

# We prescribe a linear temperature profile that
# matches the boundary conditions defined below plus
# a small perturbation with amplitude A.
subsection Initial temperature model
  set Model name = function

  subsection Function
    set Variable names      = x, y
    set Function constants  = A=0.01, pi=3.1415926536
    set Function expression = (1.0-y) + A*cos(pi*x)*sin(pi*y)
  end
end

subsection Boundary temperature model
  set Fixed temperature boundary indicators   = bottom, top
  set List of model names = box

  subsection Box
    set Bottom temperature = 1
    set Left temperature   = 0
    set Right temperature  = 0
    set Top temperature    = 0
  end
end

subsection Boundary velocity model
  set Tangential velocity boundary indicators = left, right, bottom, top
end

subsection Formulation
  set Formulation = Boussinesq approximation
end


subsection Gravity model
  set Model name = vertical

  subsection Vertical
    set Magnitude = 1e8
  end
end


subsection Discretization
 set Use discontinuous composition discretization = true
  subsection Stabilization parameters
      set Use limiter for discontinuous composition solution = true, false, true, true, true, false, true, true, true, false, true, true, true, false
      set Global composition maximum = 10, 5e12,  1.0,  1.0, 1.0,  5e12,  1.0,  1.0, 1.0, 5e12,  1.0,  1.0, 1.0, -1
      set Global composition minimum = 1e-6, -5e12, 0.0, 0.0, 0.0, -5e12, 0.0, 0.0, 0.0, -5e12, 0.0, 0.0, 0.0, 1
  end
#   subsection Stabilization parameters
#     set Use artificial viscosity smoothing = true
#   end 
end 

# necessary compositional fields for CPO av base model
subsection Compositional fields
  set Number of fields = 14
  set Names of fields = scalar_viscosity, \
                        phi1, eigvalue_a1, eigvalue_a2, eigvalue_a3,\
                        theta, eigvalue_b1, eigvalue_b2, eigvalue_b3,\
                        phi2, eigvalue_c1, eigvalue_c2, eigvalue_c3,\
                        water
  set Compositional field methods = prescribed field, \
                                    particles, particles, particles, particles, \
                                    particles, particles, particles, particles, \
                                    particles, particles, particles, particles, \
                                    static

  set Types of fields = generic, \
                        generic, generic, generic, generic, \
                        generic, generic, generic, generic, \
                        generic, generic, generic, generic, \
                        generic
  set Mapped particle properties = phi1:cpo mineral 0 phi1[0], eigvalue_a1:cpo mineral 0 eigenvalues a axis[0], eigvalue_a2:cpo mineral 0 eigenvalues a axis[1], eigvalue_a3:cpo mineral 0 eigenvalues a axis[2], \
                                   theta:cpo mineral 0 theta[0], eigvalue_b1:cpo mineral 0 eigenvalues b axis[0], eigvalue_b2:cpo mineral 0 eigenvalues b axis[1], eigvalue_b3:cpo mineral 0 eigenvalues b axis[2], \
                                   phi2:cpo mineral 0 phi2[0], eigvalue_c1:cpo mineral 0 eigenvalues c axis[0], eigvalue_c2:cpo mineral 0 eigenvalues c axis[1], eigvalue_c3:cpo mineral 0 eigenvalues c axis[2]
end

subsection Initial composition model
  set List of model names = function

  subsection Function
    set Function expression = 0;\
                              0; 1/3; 1/3; 1/3;\
                              0; 1/3; 1/3; 1/3;\
                              0; 1/3; 1/3; 1/3;\
                              0
  end
end





subsection Material model
  set Model name = TosiMaterial

  subsection Tosi benchmark
    set Reference density             = 1
    set Reference specific heat       = 1
    set Reference temperature         = 0
    set Thermal conductivity          = 1
    set Thermal expansion coefficient = 1e-06
    set Thermal viscosity parameter   = 1e5
    set Initial viscosity        = 1e-1
    set Minimum viscosity        = 1e-6
    set Maximum viscosity        = 10

    set Base model               = CPO-induced anisotropic viscosity
  end 

  subsection CPO-induced Anisotropic Viscosity 
    set Reference viscosity = 0.1
    set Grain size = 1
    set Fluidity constant = 1
    set Stress exponent = 3.5
    set Grain size exponent = 0
    set Activation energy = 0
    set Use analytical inversion = true 
  end
end


subsection Postprocess
  set List of postprocessors = velocity statistics, temperature statistics, visualization, particles, crystal preferred orientation, velocity boundary statistics
  # subsection Depth average
  #   set List of output variables = temperature, viscosity
  #   set Time between graphical output = 0.05
  #   set Number of zones = 10
  # end

  subsection Particles
    set Time between data output = 0.05
    set Data output format       = vtu
    set Exclude output properties = rotation_matrix, volume fraction
  end

  subsection Crystal Preferred Orientation
    set Time between data output = 0.05
    set Write in background thread = true
    set Compress cpo data files = false
    set Write out raw cpo data = mineral 0: volume fraction, mineral 0: Euler angles
    set Write out draw volume weighted cpo data = # mineral 0: volume fraction, mineral 0: Euler angles
  end

  subsection Visualization
    set List of output variables = material properties, strain rate, named additional outputs, stress, shear stress
    set Time between graphical output = 0.002

    subsection Material properties
      set List of material properties = viscosity, density
    end
  end
end


subsection Particles
  set List of particle properties = integrated strain invariant, crystal preferred orientation, cpo bingham average
  set Allow cells without particles = true
  set Interpolation scheme =   quadratic least squares # cell average 
  set Particle generator name =  random uniform
  set Minimum particles per cell  = 16
  set Maximum particles per cell  = 17
  set Load balancing strategy     = remove and add particles

  subsection Crystal Preferred Orientation

    subsection Initial grains
      set Minerals = Olivine: A-fabric
      set Volume fractions minerals = 1.0
    end

    set Number of grains per particle = 1000
    set Property advection method = Backward Euler
    set Property advection tolerance = 1e-15
    set CPO derivatives algorithm = D-Rex 2004

    subsection D-Rex 2004
      set Mobility = 0 # 10
      set Stress exponents = 3.5
      set Exponents p = 1.5
      set Threshold GBS = 0.3
      set Nucleation efficiency = 0 # 5
    end
  end

  subsection CPO Bingham Average
    set Random number seed = 200
    # necessary for particle property mapping
    set Use rotation matrix = false 
  end
end
