include ../Tosi_base-iso-CPO.prm

set Additional shared libraries            = ./libtosi-aniso.so
set Output directory                       = $ASPECT_SOURCE_DIR/../output/aniso-viscoplastic/output-Case2_4-plastic-v3-CPO
set Maximum first time step = 1e-4
set Nonlinear solver scheme =  single Advection, iterated Stokes
set Nonlinear solver tolerance             = 1e-5
set Nonlinear solver failure strategy =  cut timestep size
set Max nonlinear iterations = 50 
set End time = 0.2


subsection Solver parameters
  subsection Stokes solver parameters
    set Stokes solver type = block AMG
    set Number of cheap Stokes solver steps= 200
    set Linear solver tolerance            = 1e-6
  end 
end 

subsection Mesh refinement
  set Initial global refinement = 0 #5
end
# Between the cases the "Pressure viscosity parameter" ($\Delta_{\eta}_z$),
# the "Yield stress" ($\sigma_y$) and the "Nonlinear viscosity constant" ($\eta^*$)
# are varied, see Eq. (6-8) and Table 1 of the paper.
subsection Material model
  subsection Tosi benchmark
    set Pressure viscosity parameter  = 1
    set Yield stress          = 1
    set Nonlinear viscosity constant  = 1e-3
    set Initial viscosity        = 0.115
    set Rate factor = 1 # default
    set Power law exponent = 1e5 # default represents n \to \infty

    set Base model               = CPO-induced anisotropic viscosity
  end 

  subsection CPO-induced Anisotropic Viscosity 
    set Reference viscosity = 0.1
    set Grain size = 1
    set Activation energy = 0
    set Fluidity constant = 1
    set Grain size exponent = 0
    set Stress exponent = 3.5
  end
end

subsection Postprocess
  subsection Visualization
    set Time between graphical output = 0.002
  end
end 